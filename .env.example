# Copy to .env and fill in. .env is never committed.

# DATABASE_URL's password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://ft:change-me@db:5432/ft
POSTGRES_PASSWORD=change-me
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384
HC_FETCH_URL=            # healthchecks.io ping URLs
HC_DIGEST_URL=
TZ=Europe/Helsinki
USER_AGENT=FinlandToday/0.1 (+https://your-domain/about)

# Set to prod on the server so Caddy starts. Leave unset locally.
# COMPOSE_PROFILES=prod

# Host port for the dev database (docker-compose.override.yml). Change it if 5432 is taken.
DB_HOST_PORT=5432
