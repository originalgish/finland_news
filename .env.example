# Copy to .env and fill in. .env is never committed.

# DATABASE_URL's password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://ft:change-me@db:5432/ft
POSTGRES_PASSWORD=change-me
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MAX_ARTICLES_PER_RUN=500
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384
HC_FETCH_URL=            # healthchecks.io ping URLs
HC_DIGEST_URL=
TZ=Europe/Helsinki
# The outlets see this. On the server, put your SITE_DOMAIN in it.
USER_AGENT=FinlandNews/0.1 (+https://your-domain)

# Production only: set these on the server, leave them unset locally. See DEPLOY.md.
# COMPOSE_PROFILES=prod starts Caddy. COMPOSE_FILE stops the dev override from publishing
# the database and web ports on the public host.
COMPOSE_PROFILES=
# COMPOSE_FILE=docker-compose.yml
SITE_DOMAIN=
BASIC_AUTH_USER=
# Hash from `docker run --rm caddy:2 caddy hash-password`. Keep the single quotes, because
# the hash contains $ signs.
BASIC_AUTH_HASH=

# Backups (scripts/backup.sh). Set these on the server. See DEPLOY.md.
BACKUP_DIR=
BACKUP_REMOTE=
HC_BACKUP_URL=

# Host port for the dev database (docker-compose.override.yml). Change it if 5432 is taken.
DB_HOST_PORT=5432

# Host port for the dev web app. macOS AirPlay Receiver uses 5000, so set this to 8080 there.
WEB_HOST_PORT=5000
